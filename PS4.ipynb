    "# Problem 2 Global and Regional Map Visualization\n",
    "\n",
    "import xarray as xr\n",
    "import matplotlib.pyplot as plt\n",
    "import cartopy.crs as ccrs\n",
    "import cartopy.feature as cfeature\n",
    "import numpy as np\n",
    "\n",
    "# --------------------------------------------------------------\n",
    "# 1. Load the CESM2 dataset\n",
    "# --------------------------------------------------------------\n",
    "file_path = \"CESM2_200001-201412.nc\"\n",
    "ds = xr.open_dataset(file_path)\n",
    "\n",
    "print(\"Variables in dataset:\")\n",
    "print(ds.data_vars)\n",
    "\n",
    "var_name = 'tas'  # change if needed\n",
    "da = ds[var_name].mean(dim='time')  # multi-year mean\n",
    "\n",
    "# --------------------------------------------------------------\n",
    "# 2. Global Map (2.1)\n",
    "# --------------------------------------------------------------\n",
    "fig = plt.figure(figsize=(12, 6))\n",
    "ax = plt.axes(projection=ccrs.Robinson())  # global projection\n",
    "da.plot(\n",
    "    ax=ax,\n",
    "    transform=ccrs.PlateCarree(),\n",
    "    cmap='coolwarm',\n",
    "    cbar_kwargs={'label': f'{var_name} (units)'},\n",
    ")\n",
    "ax.set_title(f'Global Distribution of {var_name.upper()} (2000–2014)', fontsize=14, fontweight='bold')\n",
    "\n",
    "# Add gridlines\n",
    "gl = ax.gridlines(draw_labels=True, linewidth=0.5, color='gray', alpha=0.5)\n",
    "gl.top_labels = gl.right_labels = False\n",
    "\n",
    "# Add features\n",
    "ax.add_feature(cfeature.COASTLINE, linewidth=0.6)\n",
    "ax.add_feature(cfeature.BORDERS, linewidth=0.4)\n",
    "ax.add_feature(cfeature.LAND, facecolor='lightgray')\n",
    "\n",
    "# Add annotation and text box\n",
    "ax.text(0.01, 0.01, 'Data: CESM2 Model Output\\nProjection: Robinson', \n",
    "        transform=ax.transAxes, fontsize=9, bbox=dict(facecolor='white', alpha=0.6))\n",
    "\n",
    "plt.show()\n",
    "\n",
    "# --------------------------------------------------------------\n",
    "# 3. Regional Map (2.2)\n",
    "# --------------------------------------------------------------\n",
    "fig = plt.figure(figsize=(10, 6))\n",
    "# Example region: East Asia (lon 90–150E, lat 10–60N)\n",
    "ax = plt.axes(projection=ccrs.PlateCarree())\n",
    "region = da.sel(lat=slice(10, 60), lon=slice(90, 150))\n",
    "\n",
    "region.plot(\n",
    "    ax=ax,\n",
    "    transform=ccrs.PlateCarree(),\n",
    "    cmap='coolwarm',\n",
    "    cbar_kwargs={'label': f'{var_name} (units)'},\n",
    ")\n",
    "\n",
    "ax.set_extent([90, 150, 10, 60], ccrs.PlateCarree())\n",
    "ax.set_title(f'Regional Distribution of {var_name.upper()} – East Asia (2000–2014)', fontsize=14, fontweight='bold')\n",
    "\n",
    "# Axis labels and ticks\n",
    "ax.set_xlabel(\"Longitude (°E)\")\n",
    "ax.set_ylabel(\"Latitude (°N)\")\n",
    "\n",
    "# Add gridlines and features\n",
    "gl = ax.gridlines(draw_labels=True, linewidth=0.5, color='gray', alpha=0.5)\n",
    "gl.top_labels = gl.right_labels = False\n",
    "ax.add_feature(cfeature.COASTLINE, linewidth=0.6)\n",
    "ax.add_feature(cfeature.BORDERS, linewidth=0.4)\n",
    "\n",
    "# Add annotation and text box\n",
    "ax.text(0.02, 0.02, 'Subset: East Asia\\nProjection: PlateCarree', \n",
    "        transform=ax.transAxes, fontsize=9, bbox=dict(facecolor='white', alpha=0.6))\n",
    "\n",
    "plt.show()\n"
   ]
