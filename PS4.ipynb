    "# Problem 1 Global Earthquakes\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import cartopy.crs as ccrs\n",
    "import cartopy.feature as cfeature\n",
    "import numpy as np\n",
    "\n",
    "# 读取数据\n",
    "df = pd.read_csv(\"usgs_earthquakes.csv\")\n",
    "df[\"time\"] = pd.to_datetime(df[\"time\"], errors=\"coerce\")\n",
    "\n",
    "# 筛选2014年且震级≥6.5的地震\n",
    "df2014 = df[(df[\"time\"].dt.year == 2014) & (df[\"mag\"] >= 6.5)]\n",
    "\n",
    "# 取震级最高的50次\n",
    "df_top50 = df2014.sort_values(\"mag\", ascending=False).head(50)\n",
    "\n",
    "lons = df_top50[\"longitude\"].to_numpy()\n",
    "lats = df_top50[\"latitude\"].to_numpy()\n",
    "mags = df_top50[\"mag\"].to_numpy()\n",
    "\n",
    "# 绘图\n",
    "plt.figure(figsize=(16, 8))\n",
    "\n",
    "# 使用太平洋为中心的Robinson投影\n",
    "proj = ccrs.Robinson(central_longitude=180)\n",
    "ax = plt.axes(projection=proj)\n",
    "ax.set_global()\n",
    "\n",
    "# 背景\n",
    "ax.stock_img()  # 蓝色海洋背景\n",
    "ax.coastlines(linewidth=0.6)\n",
    "ax.add_feature(cfeature.BORDERS, linewidth=0.4)\n",
    "ax.add_feature(cfeature.LAND, facecolor=\"none\", edgecolor=\"black\", linewidth=0.3)\n",
    "\n",
    "FIXED_SIZE = 60 ,
    "\n",
    "# 散点图 - 颜色变化，大小固定\n",
    "sc = ax.scatter(\n",
    "    lons, lats,\n",
    "    c=mags,  # 颜色随震级变化\n",
    "    cmap=\"Reds\", \n",
    "    vmin=6.5,\n",
    "    vmax=8.2,\n",
    "    s=FIXED_SIZE, \n",
    "    transform=ccrs.PlateCarree(),\n",
    "    edgecolor=\"black\",\n",
    "    linewidth=0.8,\n",
    "    alpha=0.8,\n",
    "    zorder=3\n",
    ")\n",
    "\n",
    "# 色标 - 水平放置\n",
    "cbar = plt.colorbar(sc, orientation='horizontal', \n",
    "                    shrink=0.8, pad=0.08, aspect=40)\n",
    "cbar.set_label('Magnitude', fontsize=12, fontweight='bold')\n",
    "\n",
    "# 设置色标刻度\n",
    "cbar_ticks = np.arange(6.5, 8.2, 0.2)  # 6.5, 6.7, ..., 8.1\n",
    "cbar.set_ticks(cbar_ticks)\n",
    "cbar.set_ticklabels([f\"{t:.1f}\" for t in cbar_ticks])\n",
    "\n",
    "# 网格线\n",
    "gl = ax.gridlines(\n",
    "    draw_labels=True,\n",
    "    linewidth=0.5,\n",
    "    color='gray',\n",
    "    alpha=0.5,\n",
    "    linestyle='--'\n",
    ")\n",
    "gl.top_labels = False\n",
    "gl.right_labels = False\n",
    "\n",
    "# 标题和标注\n",
    "plt.title(\"Top 50 Earthquakes of 2014\", \n",
    "          fontsize=16, fontweight=\"bold\", pad=20)\n",
    "\n",
    "# 左下角标注\n",
    "ax.text(0.01, 0.01, \n",
    "        \"Data source: USGS\\nProjection: Robinson\", \n",
    "        transform=ax.transAxes, \n",
    "        fontsize=10, \n",
    "        verticalalignment='bottom',\n",
    "        bbox=dict(boxstyle=\"round,pad=0.3\", \n",
    "                  facecolor=\"white\", \n",
    "                  alpha=0.8,\n",
    "                  edgecolor='gray'))\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 输出统计信息\n",
    "print(\"=\"*50)\n",
    "print(\"数据统计：\")\n",
    "print(f\"总点数: {len(mags)}\")\n",
    "print(f\"震级范围: {mags.min():.2f} - {mags.max():.2f}\")\n",
    "print(f\"平均震级: {mags.mean():.2f}\")\n",
    "print(f\"点大小: 固定值 {FIXED_SIZE}\")"
   ]
  },
